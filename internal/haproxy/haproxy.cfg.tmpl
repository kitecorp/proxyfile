{{- /*
The HAProxy configuration of one gateway, for HAProxy 3.2 and 3.4 (generate.go's view). Each value from the proxyfile
arrives quoted, or in a form HAProxy reads as written (view), so this file writes no text of the input itself.
HAProxy runs the http-request rules of a frontend in the order written, so the order below is part of what each rule
does.
*/ -}}
{{.Header}}# Loads proxyfile.lua, the script proxyfile render writes beside this file.
.if version_before(3.2)
  .alert "proxyfile writes this file for HAProxy 3.2 and 3.4; this HAProxy is older, so it stops here"
.endif
global
  {{- /* normalize-uri is experimental: without this line HAProxy 3.4.7 refuses the file (measured). */}}
  expose-experimental-directives
  default-path config
  {{- /* The script's functions answer what this file cannot (proxyfile.lua says which); default-path config makes
  HAProxy read it from this file's folder. The script reads no boolean sample, and without the tune line HAProxy 3.4.7
  warned at every start (measured). */}}
  tune.lua.bool-sample-conversion normal
  lua-load-per-thread proxyfile.lua
  {{- /* Envoy admits 100 request header lines and refuses 101. HAProxy counts the request line among its lines: with
  100 here it refused 100 header lines, and with 101, its default, it served 100 and refused 101 (measured on HAProxy
  3.2.26 and 3.4.7 beside Envoy 1.40.2). */}}
  tune.http.maxhdr 101
{{- if .TLS}}
  {{- /* Without this line HAProxy 3.4.7 also accepted TLS 1.2 suites Envoy 1.40.2 refuses, such as AES128-SHA; with
  it, only the ECDHE AES-GCM and ChaCha20 suites, as Envoy (measured). */}}
  ssl-default-bind-ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305
  {{- /* Envoy 1.40.2 takes the key exchange groups X25519MLKEM768, X25519 and P-256 alone, where HAProxy 3.2.26 and
  3.4.7 also took P-384, P-521, X448 and, over TLS 1.3, ffdhe2048 without this line (measured). */}}
  ssl-default-bind-curves X25519MLKEM768:X25519:P-256
{{- end}}

defaults
  mode http
  {{- /* With no retries line HAProxy 3.4.7 tried a refused connection 3 more times (measured); Envoy's file retries
  only where a route asks, which this version does not write. */}}
  retries 0
  {{- /* HAProxy kept its connections to a service and, when the service closed one it reused before its answer, sent
  the request again on a new one: over HTTP/1.1 by closing the client's connection, which the client tried again, and
  over HTTP/2 by refusing the stream, so the service received it twice, where Envoy 1.40.2 answers 502 (measured on
  HAProxy 3.2.26 and 3.4.7, over HTTP/1.1 and HTTP/2 and to a gRPC service). With these lines each request reaches the
  service on a connection of its own, closed after the answer, and the service receives no Connection header, as from
  Envoy; the second line keeps HAProxy from sending Connection: close. A gRPC server's connection is HTTP/2, which
  these lines do not close, so its server line writes max-reuse 0 (backends). */}}
  option http-server-close
  option http-pretend-keepalive
  {{- /* HAProxy 3.2.26 served a client that sent its request and closed its half of the connection, where Envoy 1.40.2
  answers it nothing; 3.4.7 has this line on by default. With it neither version gives such a client the service's
  answer, and a request the check is asked about reaches no service: HAProxy answers 400 or 403 or nothing where Envoy
  only closes, and a request the check is not asked about may still reach the service, as through Envoy (measured with
  and without the check; timeout client-fin and the fs.aborted fetch changed nothing). */}}
  option abortonclose
  timeout connect 5s
  {{- /* Envoy's stream idle timeout is 5 minutes (read in its documentation). Without timeouts.request the Envoy
  output ends a request 15 s after it (a route's default timeout), which HAProxy cannot write for a whole answer: 15 s
  with no data from the service gives one that says nothing a 504 at the same time (measured), and lets an answer
  that keeps coming run past 15 s, the difference timeouts.request's declaration names. With timeouts.request: none
  only the 5 minutes are left. */}}
  timeout client 300s
  timeout server {{.ServerTimeout}}
  {{- /* Envoy sends the body of a request on and no trailer of it, where HAProxy passed a trailer to the service over
  HTTP/1.1 and HTTP/2 without this line (measured). */}}
  option http-drop-request-trailers
  {{- /* An empty 503 needs no file beside the configuration; the 502 rule of the frontend turns it into Envoy's answer
  to a service out of reach. A service that closed the connection before its answer got HAProxy's HTML 502 without the
  second line, where Envoy's 502 is empty (measured). Envoy's 504 is upstream request timeout as text/plain, where
  HAProxy's is an HTML page, and a gRPC call's carries no body, which the frontend turns into gRPC's form, so the
  frontend sets the text for every other request (txn.timeout_text). */}}
  http-error status 503
  http-error status 502
  http-error status 504 content-type text/plain lf-string "%[var(txn.timeout_text)]"
{{- with .TLS}}

crt-store
  load crt {{.Certificate}} key {{.Key}} alias public
{{- end}}
{{- with .Admin}}

frontend admin
  bind 127.0.0.1:{{.}}
  monitor-uri /ready
  http-request return status 404
{{- end}}

frontend public
  bind :{{.Listen}}{{with .TLS}} ssl crt @/public alpn h2,http/1.1{{with .ClientsCA}} verify required ca-file {{.}}{{end}}{{end}}
  # a control byte in a header value, refused before any other rule, as Envoy's parser refuses it
  {{- /* Envoy 1.40.2 answers 400 over HTTP/1, and closes the connection over HTTP/2, to a header value that holds a byte
  from 0x01 to 0x08, 0x0b, 0x0c, 0x0e to 0x1f or 0x7f, a header remove_from_clients names too, where HAProxy 3.2.26
  and 3.4.7 passed it to the service; HAProxy's parser refuses CR, LF and NUL itself, and reject resets an HTTP/2
  stream (measured). The rule's cost was below what 20,000 requests of 90 header lines could show. No fetch reads a
  request's trailer, so a trailer that holds such a byte is not refused (HAProxy's declaration names it). */}}
  http-request set-var(txn.control) bool(true) if { req.hdrs -m reg '[\x01-\x08\x0b\x0c\x0e-\x1f\x7f]' }
  http-request return status 400 if { var(txn.control) -m bool } !{ fc_http_major 2 }
  http-request reject if { var(txn.control) -m bool }
{{- with .Removed}}
  # remove_from_clients, before every rule but the control byte refusal
{{- range .}}
  http-request del-header {{.}}
{{- end}}
{{- end}}
{{- with .Unchecked}}
  http-request del-header {{.}}
{{- end}}
  # what Envoy refuses before it reads a request further, and the headers it removes
  {{- /* Each answer was measured on Envoy 1.40.2 beside HAProxy 3.2.26 and 3.4.7, which answered alike. Envoy answers
  426 to every HTTP/1 version but 1.1, where HAProxy served 0.0 to 0.9 as written and 1.2 to 9.9 as HTTP/1.1, so that a
  service answering HTTP/0.9 with its body alone had that body read as the answer's headers; req.ver gives the version
  as sent, and 2.0 both for HTTP/2 and for HTTP/2.0 on an HTTP/1 connection, which fc_http_major tells apart. Over
  HTTP/1.1 Envoy answers a method its parser does not know 400 (a method in another letter case too), where HAProxy
  served it. An absolute target, which HAProxy sends on in absolute form after it drops a default or empty
  port from the target and the Host header, is answered 400: no rule sees the port it dropped, and Envoy sends the path
  alone with the line's host as Host, and answers an empty port 400. */}}
  http-request return status 426 if !{ req.ver 1.1 } !{ fc_http_major 2 }
  http-request return status 400 if { req.ver 1.1 } !{ method {{.Methods}} }
  http-request return status 400 if { req.ver 1.1 } !{ url_beg / }
  {{- /* A client's own upgrade field over HTTP/2 is refused by HAProxy's parser, so an HTTP/2 request that holds one is
  a WebSocket over HTTP/2 (extended CONNECT), which HAProxy 3.2.26 sent the service as an HTTP/1.1 upgrade with a key
  of its own, where HAProxy 3.4.7 answers 400 and Envoy 1.40.2 closes the connection (measured). */}}
  http-request return status 400 if { req.ver 2.0 } { req.fhdr(upgrade) -m found }
  {{- /* Envoy removes a header another Connection token names, or answers 400 when it names one Envoy keeps. HAProxy
  drops close and keep-alive from Connection itself and passes any other token and the header it names, so a token
  other than these, compared in any letter case as RFC 9110 asks, is answered 400; an empty element passes, as Envoy
  takes it. */}}
  http-request return status 400 if { req.hdr(connection) -i -m reg '^(?!{{.ConnectionTokens}}?\z)' }
  {{- /* Envoy answers ten Connection tokens or more 400 (generator.MostConnectionTokens). HAProxy removes close and
  keep-alive before any rule reads the header, so the rule counts the other tokens alone, and an empty element too,
  which Envoy takes. */}}
  http-request return status 400 if { req.hdr_cnt(connection) ge {{.TooManyConnectionTokens}} }
  {{- /* Envoy removes HTTP2-Settings from an h2c upgrade, which it serves as a plain request, and keeps it on any other
  request. HAProxy drops an h2c upgrade's Upgrade header and its upgrade token before any rule reads the request, and
  keeps the token HTTP2-Settings (measured on HAProxy 3.2.26 and 3.4.7), so an upgrade is a request whose Connection
  names HTTP2-Settings: it is answered 400, and a request that carries the header alone passes, as through Envoy. */}}
  http-request return status 400 if { req.hdr(connection) -i -m str http2-settings }
  {{- /* HAProxy writes the line break of a header line folded onto the next as two spaces, so a folded value holds
  three spaces or tabs in a row, where Envoy drops the line break. A value that holds them unfolded is refused too. */}}
  http-request return status 400 if { req.hdrs -m reg '[ ][ ][ \t]' } || !{ req.hdrs -m found }
  {{- /* Over HTTP/2 Envoy admits 100 header fields with the 4 pseudo-headers of a request and refuses one more, where
  HAProxy writes :authority as one Host line, counted below, and joins every cookie field into one line, so each
  cookie counts as a field. */}}
  http-request set-var(txn.cookies) req.cook_cnt
  http-request return status 400 if { req.ver 2.0 } { req.fhdr_cnt,add(txn.cookies) ge 98 }
  {{- /* Envoy sends TE: trailers in any letter case when Connection names te, and HAProxy only as written in lower case.
  Envoy sends no Connection header on but a WebSocket upgrade's, nor Keep-Alive, and passes a service's Keep-Alive to
  no client, which HAProxy 3.2.26 and 3.4.7 passed on over HTTP/1.1 (measured): it speaks of the service's connection,
  not the client's. */}}
  http-request set-header te trailers if { req.hdr(connection) -i -m str te } { req.hdr(te) -i -m str trailers }
  http-request del-header connection unless { req.hdr(upgrade) -i -m str websocket }
  http-request del-header keep-alive
  http-response del-header keep-alive
{{- range .EnvoyRemoved}}
  http-request del-header {{.}}
{{- end}}
  # the lines of each header Envoy joins, as one line, before anything reads them
  {{- /* pf_join writes them as Envoy does (proxyfile.lua). Every rule after it reads a header's whole line (req.fhdr),
  never its comma-separated parts (req.hdr): a single Origin line that holds a listed origin after a comma is not that
  origin, for Envoy. A request whose run stopped part way is answered 400. */}}
  http-request lua.pf_join
  http-request return status 400 if !{ var(txn.joined) -m found }
  # Expect: 100-continue, answered at once and passed to no service
  {{- /* Envoy answers Expect: 100-continue itself at once, before it routes the request or asks the check, and removes
  the header, where HAProxy passed it to the service and the client had its 100 only when the service sent one
  (measured on Envoy 1.40.2 beside HAProxy 3.2.26 and 3.4.7). wait-for-body (the configuration manual, section 4.4,
  "wait-for-body") sends the 100 and removes the header for a request with a body (src/http_ana.c,
  http_handle_expect_hdr), and at-least 1 lets the request go on at its first byte, so nothing is held but the
  headers until the body starts: a 128 MiB upload with Expect took the time and memory one without it took. It
  answers 408 after time, Envoy's stream idle timeout of 5 minutes, which timeout client 300s matches. A request with
  no body gets no 100, which no client waits for, and its Expect is removed by the second line. */}}
  http-request wait-for-body time 300s at-least 1 if { req.hdr(expect) -i -m str 100-continue }
  http-request del-header expect if { req.hdr(expect) -i -m str 100-continue }
  # client_address: {{.ClientAddress}}
{{- if .Connection}}
  {{- /* Envoy takes the client for one it faces: it removes what only a proxy in front may send, appends the peer's
  address to the client's own X-Forwarded-For on the same line, or writes it alone when the client sent none or an
  empty one, and replaces x-envoy-external-address and x-forwarded-proto (measured). */}}
{{- range .Faced}}
  http-request del-header {{.}}
{{- end}}
  http-request set-header x-forwarded-for "%[req.fhdr(x-forwarded-for)],%[src]" if { req.fhdr(x-forwarded-for) -m len gt 0 }
  http-request set-header x-forwarded-for %[src] unless { req.fhdr(x-forwarded-for) -m len gt 0 }
  http-request set-header x-envoy-external-address %[src]
  http-request set-header x-forwarded-proto {{.Scheme}}
{{- else}}
  {{- /* The x-forwarded-proto a proxy in front sent is kept, as Envoy keeps it. */}}
  http-request set-header x-forwarded-proto {{.Scheme}} unless { req.hdr(x-forwarded-proto) -m found }
{{- end}}
  # every response carries the request's id
  {{- /* Envoy replaces the id of a request from a client it faces, and keeps the id a proxy in front sent. */}}
  http-request set-header x-request-id %[uuid(4)]{{if not .Connection}} unless { req.hdr(x-request-id) -m found }{{end}}
  http-request set-var(txn.request_id) req.fhdr(x-request-id)
  http-after-response set-header x-request-id %[var(txn.request_id)]
  # a gRPC call, as Envoy tells one: content type application/grpc alone or before a +, compared as written
  {{- /* Envoy 1.40.2 answered application/grpc+proto in gRPC's form, and application/grpc;x=1, Application/GRPC and
  application/grpc-web as any other request (measured). */}}
  http-request set-var(txn.grpc_call) bool(true) if { req.fhdr(content-type) -m reg '^application/grpc(\+|$)' }
  # a gRPC call the file refuses itself is answered in gRPC's form, as Envoy answers one
  {{- /* Envoy 1.40.2 answers a gRPC call it refuses itself before any service 200, with content-type
  application/grpc, the grpc-status of its status (GRPC) and, on a 403 to a request with an Origin, grpc-message
  Invalid CORS request, in one header frame (measured over HTTP/1.1 and HTTP/2). Each refusal below that Envoy makes
  too sets txn.grpc_answer for a gRPC call and answers it so first, as the pass rule does; one Envoy does not make, as
  for a client's X-Request-Id too long for HAProxy, answers a gRPC call as any other request. HAProxy's return writes
  no content-type without a body, and writes content-length: 0, which Envoy writes over HTTP/1.1 alone. */}}
  http-after-response set-header content-type application/grpc if { var(txn.grpc_answer) -m bool }
  http-after-response del-header content-length if { var(txn.grpc_answer) -m bool } { fc_http_major 2 }
  # the path, normalised before anything reads it
  {{- /* pf_escape escapes what Envoy escapes before it picks a route. The regsub rules turn an escaped slash or
  backslash into a slash before the dot segments are resolved, so /open/..%2fprivate cannot reach a route as /open/ and
  the service as /private; '\\x5c' is a backslash (measured on HAProxy 3.2.26 and 3.4.7). A path the script did not
  escape is answered 400. Every escape that is not decoded keeps the case of its hex digits and an invalid one, such as
  %zz, passes, as through Envoy: neither normalize-uri line holds strict, and no line writes percent-to-uppercase.
  Envoy answers 400 to %00 in a path. */}}
  http-request normalize-uri fragment-strip
  http-request set-var(txn.path) path,lua.pf_escape,regsub(%2f,/,gi),regsub(%5c,/,gi),regsub('\\x5c',/,g)
  http-request return status 400 if !{ var(txn.path) -m found }
  http-request set-path %[var(txn.path)]
  http-request normalize-uri percent-decode-unreserved
  http-request normalize-uri path-merge-slashes
  http-request normalize-uri path-strip-dot
  http-request normalize-uri path-strip-dotdot full
  http-request set-var(txn.grpc_answer) bool(true) if { path -m sub %00 } { var(txn.grpc_call) -m bool }
  http-request return status 200 hdr grpc-status {{.GRPC.BadRequest}} if { var(txn.grpc_answer) -m bool }
  http-request return status 400 if { path -m sub %00 }
  # the environment, by the Host header without its port
  http-request set-var(txn.host) req.hdr(host),host_only,lower
{{- range .Environments}}
  {{- /* The environment is named by its place; its own name, which may hold any text, is only in the comment. Each
  list of the proxyfile is written one value a line: HAProxy reads at most 65 words on a line (measured on HAProxy
  3.2.26 and 3.4.7). Every value of the file in an acl line comes after --, the end of the line's flags: a host the
  reader admits may start with -, and HAProxy 3.4.7 read -f as a flag that names a file, and -n and -i as flags,
  matching no host. */}}
  # {{.ID}}: {{.Comment}}
{{- $id := .ID}}
{{- range .Hosts}}
  acl {{$id}}_host var(txn.host) -m str -- {{.}}
{{- end}}
  http-request set-var(txn.environment) str({{.ID}}) if {{.ID}}_host
{{- end}}
  http-request set-var(txn.grpc_answer) bool(true) if !{ var(txn.environment) -m found } { var(txn.grpc_call) -m bool }
  http-request return status 200 hdr grpc-status {{.GRPC.NotFound}} if { var(txn.grpc_answer) -m bool }
  http-request return status 404 if !{ var(txn.environment) -m found }
{{- if not .Connection}}
  {{- /* Under forwarded Envoy 1.40.2 answers 404 to an X-Forwarded-Proto that is empty, two empty lines or, over HTTP/1,
  spaces alone, before it reads the request's origin, preflight, dot segment or upgrade, where HAProxy passed it on
  (measured). HAProxy's HTTP/2 decoder drops a value's spaces, so spaces alone over HTTP/2 are answered 404 too, where
  Envoy serves them. */}}
  http-request set-var(txn.grpc_answer) bool(true) if { req.fhdr(x-forwarded-proto) -m found } !{ req.fhdr(x-forwarded-proto) -m len gt 0 } { var(txn.grpc_call) -m bool }
  http-request return status 200 hdr grpc-status {{.GRPC.NotFound}} if { var(txn.grpc_answer) -m bool }
  http-request return status 404 if { req.fhdr(x-forwarded-proto) -m found } !{ req.fhdr(x-forwarded-proto) -m len gt 0 }
{{- end}}
  # the routes, in the written order: the first that matches is the request's route
{{- range .Routes}}
{{- if .Program}}
  {{- /* The script runs the pattern's program in an action, which HAProxy runs in steps, letting other requests run
  between them, where a sample fetch runs at once: one request whose path 24 programs read in a fetch held a thread
  past HAProxy's watchdog, which stopped HAProxy 3.2.26 and 3.4.7 (measured). A run that set nothing, past the
  script's budget or failed, is answered 400, never read as no match. */}}
  # route {{.ID}} matches the pattern {{.Pattern}}
  http-request lua.pf_route {{.ID}} {{.Program}} if !{ var(txn.route) -m found }
  http-request return status 400 if !{ var(txn.route) -m found } !{ var(txn.pattern{{.ID}}) -m found }
{{- end}}
{{- $id := .ID}}
{{- range .Matches}}
  http-request set-var(txn.route) str({{$id}}) if !{ var(txn.route) -m found } {{.}}
{{- end}}
{{- end}}
  # a dot segment with a ; parameter, written or escaped once, reaches no service
  {{- /* path-strip-dot and path-strip-dotdot do not take ..; or .; as a dot segment (measured on HAProxy 3.2.26 and
  3.4.7). Envoy's file refuses one by a route of its own, the first of each environment, so a request with one has a
  route; Envoy answers a request with none 404 before it reads its upgrade or its origin, and the dot segment 400
  after both, with no CORS header (measured on Envoy 1.40.2). */}}
  acl dot_segment path_reg '/\.\.?(;|%3[Bb])'
  http-request set-var(txn.grpc_answer) bool(true) if !{ var(txn.route) -m found } !dot_segment { var(txn.grpc_call) -m bool }
  http-request return status 200 hdr grpc-status {{.GRPC.NotFound}} if { var(txn.grpc_answer) -m bool }
  http-request return status 404 if !{ var(txn.route) -m found } !dot_segment
  # WebSocket is the one upgrade passed on
  {{- /* Envoy answers every 403 of its own with the body Invalid CORS request when the request carries an Origin
  header, this one too (measured). */}}
  acl has_origin req.fhdr(origin) -m found
  acl upgrade req.fhdr(upgrade) -m found
  acl websocket req.fhdr(upgrade) -i -m str websocket
  http-request set-var(txn.grpc_answer) bool(true) if upgrade !websocket { var(txn.grpc_call) -m bool }
  http-request return status 200 hdr grpc-status {{.GRPC.Forbidden}} hdr grpc-message "Invalid CORS request" if { var(txn.grpc_answer) -m bool } has_origin
  http-request return status 200 hdr grpc-status {{.GRPC.Forbidden}} if { var(txn.grpc_answer) -m bool }
  http-request return status 403 content-type text/plain string "Invalid CORS request" if upgrade !websocket has_origin
  http-request return status 403 if upgrade !websocket
  {{- /* Every file checks the browser origin, as Envoy does with or without cors and lists; only the lines that read a
  list depend on one. */}}
  # browser origins: none, an environment's own host, or its origins and patterns
{{- range .Environments}}
{{- $id := .ID}}
{{- range .Origins}}
  acl {{$id}} req.fhdr(origin) -i -m str -- {{.}}
{{- end}}
{{- range .Patterns}}
  acl {{$id}} req.fhdr(origin) -m reg -- {{.}}
{{- end}}
{{- range .Own}}
  acl {{$id}}_own req.fhdr(origin) -m reg -- {{.}}
{{- end}}
{{- end}}
{{- range .Environments}}
{{- if .Listed}}
  http-request set-var(txn.cors) bool(true) if { var(txn.environment) -m str {{.ID}} } {{.ID}}
{{- end}}
{{- end}}
  {{- /* An origin is admitted with no Origin header, by its environment's origins or patterns, or on one of the
  environment's own hosts, which gets no CORS header; any other is refused. */}}
  http-request set-var(txn.admitted) bool(true) if !has_origin
{{- if .Listed}}
  http-request set-var(txn.admitted) bool(true) if { var(txn.cors) -m bool }
{{- end}}
{{- range .Environments}}
  http-request set-var(txn.admitted) bool(true) if { var(txn.environment) -m str {{.ID}} } {{.ID}}_own
{{- end}}
  http-request set-var(txn.grpc_answer) bool(true) if !{ var(txn.admitted) -m bool } { var(txn.grpc_call) -m bool }
  http-request return status 200 hdr grpc-status {{.GRPC.Forbidden}} hdr grpc-message "Invalid CORS request" if { var(txn.grpc_answer) -m bool }
  http-request return status 403 content-type text/plain string "Invalid CORS request" if !{ var(txn.admitted) -m bool }
{{- if .Listed}}
  {{- /* An admitted Origin longer than the file echoes (echoRoom) is refused before the check and the service, as Envoy
  answers its own 403s, where HAProxy answered 500 after the service did the work. */}}
  http-request return status 403 content-type text/plain string "Invalid CORS request" if { var(txn.cors) -m bool } { req.fhdr(origin) -m len gt {{.LongestOrigin}} }
{{- end}}
{{- if not .Connection}}
  {{- /* Under forwarded a client's own X-Request-Id is kept and echoed on every answer, in the same room as an echoed
  Origin, so one longer than the room left (idRoom) is answered 400 before the check and the service, where HAProxy
  answered 500 after the service did the work and Envoy serves it. */}}
{{- if .Listed}}
  http-request set-var(txn.id_length) var(txn.request_id),length
  http-request return status 400 if { var(txn.cors) -m bool } { req.fhdr(origin),length,add(txn.id_length) gt {{.LongestEcho}} }
{{- end}}
  http-request return status 400 if { var(txn.request_id) -m len gt {{.LongestID}} }
{{- end}}
{{- with .Check}}
  # the auth check
  {{- /* Envoy asks its check after CORS and before the route that answers a dot segment (measured on Envoy 1.40.2), so
  the check comes here: Ask holds which requests it asks (generate.go). A preflight Envoy's CORS filter answers is
  never asked. Each method's RPC question is set for the check alone: the client's copies went first, and the two
  headers go after it. The action (proxyfile.lua) asks the check through the relay at the end of the file, which bounds
  the connection's time, and sets txn.pf_passed only when the request may go on: a runtime error in an action lets
  the request continue to the next rule, and HAProxy 3.4.7 aborted the action for a client that half-closed, so the
  pass rule refuses an asked request it did not let through (measured on HAProxy 3.2.26 and 3.4.7). The action copies
  a denial itself and leaves every other refusal to the pass rule, which answers as Envoy answers an unanswered check
  under deny: a gRPC call 200 with grpc-status 7, any other request 403, each with Invalid CORS request (grpc-message,
  or the body) when it carries an Origin (measured on Envoy 1.40.2); a gRPC call's content type and length come from
  the lines after txn.grpc_call. Envoy's denial carries an admitted origin's CORS answer; the origin is let go after
  the pass rule, as the dot segment's answer carries none. HAProxy writes content-length: 0 on a 304 and on an HTTP/2
  gRPC denial the script copies, where Envoy writes none, so the script asks for its removal with txn.pf_no_length. */}}
  acl pf_preflight method OPTIONS
  acl pf_preflight_method req.fhdr(access-control-request-method) -m len gt 0
  http-request set-var(txn.pf_preflight) bool(true) if has_origin pf_preflight pf_preflight_method !dot_segment
{{- range .Questions}}
  http-request set-header {{.Header}} {{.Value}} if { var(txn.route) -m str {{.Route}} } { path {{.Path}} }
{{- end}}
{{- with .OnlyWith}}
  http-request set-var(txn.pf_header) bool(true) if { req.fhdr({{.}}) -m len gt 0 } || { req.fhdr_cnt({{.}}) gt 1 } || { req.ver 2.0 } { req.fhdr({{.}}) -m found }
{{- end}}
  http-request set-var(txn.pf_ask) bool(true) if {{.Ask}}
{{- if $.Listed}}
  http-request set-var(txn.origin) req.fhdr(origin) if { var(txn.cors) -m bool }
{{- end}}
  http-request lua.pf_auth {{.Relay}} {{.Path}} {{.Millis}} {{.Unavailable}} {{.Send}} {{.Accept}} {{.SendRequest}} if { var(txn.pf_ask) -m bool }
  http-request set-var(txn.pf_refused) bool(true) if { var(txn.pf_ask) -m bool } !{ var(txn.pf_passed) -m bool }
  http-request set-var(txn.grpc_answer) bool(true) if { var(txn.pf_refused) -m bool } { var(txn.grpc_call) -m bool }
  http-request return status 200 hdr grpc-status {{$.GRPC.Forbidden}} hdr grpc-message "Invalid CORS request" if { var(txn.grpc_answer) -m bool } has_origin
  http-request return status 200 hdr grpc-status {{$.GRPC.Forbidden}} if { var(txn.grpc_answer) -m bool }
  http-request return status 403 content-type text/plain string "Invalid CORS request" if { var(txn.pf_refused) -m bool } has_origin
  http-request return status 403 if { var(txn.pf_refused) -m bool }
{{- if $.Listed}}
  http-request unset-var(txn.origin)
{{- end}}
  http-request del-header {{.ActionHeader}}
  http-after-response del-header content-length if { var(txn.pf_no_length) -m bool }
  http-request del-header {{.ReportsHeader}}
{{- end}}
  http-request set-var(txn.grpc_answer) bool(true) if dot_segment { var(txn.grpc_call) -m bool }
  http-request return status 200 hdr grpc-status {{.GRPC.BadRequest}} if { var(txn.grpc_answer) -m bool }
  http-request return status 400 if dot_segment
  acl preflight method OPTIONS
  acl preflight_method req.fhdr(access-control-request-method) -m len gt 0
{{- if .Listed}}
  http-request return status 200 hdr access-control-allow-origin "%[req.fhdr(origin)]"{{.Answer}}{{with .Expose}} hdr access-control-expose-headers {{.}}{{end}} if has_origin preflight preflight_method { var(txn.cors) -m bool }
{{- end}}
  http-request return status 200{{.Answer}} if has_origin preflight preflight_method
{{- if .Listed}}
  http-request set-var(txn.origin) req.fhdr(origin) if { var(txn.cors) -m bool }
  http-after-response set-header access-control-allow-origin "%[var(txn.origin)]" if { var(txn.origin) -m found }
{{- with .Expose}}
  http-after-response set-header access-control-expose-headers {{.}} if { var(txn.origin) -m found }
{{- end}}
{{- end}}
  http-after-response add-header vary Origin
{{- range .Rewrites}}
  http-request replace-path {{.Regex}} {{.Format}} if { var(txn.route) -m str {{.ID}} }
{{- end}}
  # a service that cannot be reached: 502 with an empty body
  {{- /* S with C or H: the service refused the connection or closed it before its answer's headers; sC: the
  connection to it timed out. Envoy 1.40.2's reason is Bad Gateway, HAProxy's Bad Gateway or Proxy Error (measured
  over HTTP/1.1). */}}
  http-after-response set-status 502 reason "Bad Gateway" if { txn.sess_term_state -m reg ^S[CH] } || { txn.sess_term_state -m str sC }
  # a service that sends nothing in time: 504 with Envoy's text and reason
  {{- /* sH: HAProxy's timeout server passed before the answer's headers (measured with Envoy 1.40.2 beside HAProxy
  3.2.26 and 3.4.7, over HTTP/1.1 and HTTP/2, to an HTTP and a gRPC service: Envoy's reason is Gateway Timeout,
  HAProxy's Gateway Time-out). */}}
  http-request set-var-fmt(txn.timeout_text) "upstream request timeout" unless { var(txn.grpc_call) -m bool }
  http-after-response set-status 504 reason "Gateway Timeout" if { txn.sess_term_state -m str sH }
  # a gRPC call to a service that cannot be reached or sends nothing in time: 200 with grpc-status 14
  {{- /* Envoy 1.40.2 answers it 200 with content-type application/grpc and grpc-status 14 in one header frame, with a
  grpc-message that names a reset of the stream, an answer that is not HTTP/2 and a timeout, where HAProxy 3.2.26 and
  3.4.7 answered 502 and 504, each without the form (measured). HAProxy's own 502, 503 and a gRPC call's 504 have no
  body (the defaults), so the form carries none. bc_err is 0 for a service that took the connection and sent nothing,
  and has no value for one that never took it, which Envoy's answer names no timeout for; bs.rst_code is the service's
  reset of the stream, and bc_glitches counts an answer in HTTP/1.1 on the connection, which carries one call
  (measured). */}}
  http-after-response set-var(txn.unreached) bool(true) if { var(txn.grpc_call) -m bool } { txn.sess_term_state -m reg ^[Ss][CH] }
  http-after-response set-status 200 if { var(txn.unreached) -m bool }
  http-after-response set-header content-type application/grpc if { var(txn.unreached) -m bool }
  http-after-response set-header grpc-status 14 if { var(txn.unreached) -m bool }
  http-after-response set-header grpc-message "upstream request timeout" if { var(txn.unreached) -m bool } { txn.sess_term_state -m str sH } { bc_err eq 0 }
  http-after-response set-header grpc-message "upstream connect error or disconnect/reset before headers. reset reason: remote reset" if { var(txn.unreached) -m bool } { bs.rst_code -m found }
  http-after-response set-header grpc-message "upstream connect error or disconnect/reset before headers. reset reason: protocol error" if { var(txn.unreached) -m bool } { bc_glitches gt 0 }
  {{- /* Envoy's answer in one header frame carries no content-length, as the file's own refusal (txn.grpc_answer). */}}
  http-after-response del-header content-length if { var(txn.unreached) -m bool } { fc_http_major 2 }
{{- range .Routes}}
  use_backend {{.Backend}} if { var(txn.route) -m str {{.ID}} }
{{- end}}
{{- range .Backends}}

backend {{.Name}}
{{- with .HostHeader}}
  http-request set-header host {{.}}
{{- end}}
{{- range .Servers}}
  server {{.}}
{{- end}}
{{- end}}
{{- with .Check}}

# the relay to the check service
{{- /* A socket's timeout in the script does not bound its connect (to an address that never answered: 303 s on HAProxy
3.4.7, 6.0 s on 3.2.26, against a timeout of 1.5 s), so the action connects to this relay, whose timeouts are
auth.timeout; retries 0 because Envoy's check cluster tries no other backend, and nolinger because without it the relay
read a check that kept sending for as long as it sent (measured). Its own defaults keep the HTTP options above off the
relay: without it HAProxy warns that two of them are ignored. */}}
defaults
  mode tcp

listen check
  bind {{.Bind}}
  timeout connect {{.Millis}}ms
  timeout client {{.Millis}}ms
  timeout server {{.Millis}}ms
  retries 0
  option nolinger
{{- range .Servers}}
  server {{.}}
{{- end}}
{{- end}}
