# LF everywhere, because the generated files are compared byte for byte.
* text=auto eol=lf
# GitHub folds generated files in a diff.
examples/*/*/envoy.yaml linguist-generated=true
examples/*/*/rpc-table.json linguist-generated=true
schema/proxyfile.schema.json linguist-generated=true
docs/images/comparison-*.svg linguist-generated=true
# GitHub colours a Proxyfile and the HOCON examples as HOCON, which Linguist maps only to .hocon and two scalafmt names.
Proxyfile linguist-language=HOCON
*.conf linguist-language=HOCON
