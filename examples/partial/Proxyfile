# The partial example in HOCON, with its RPC methods read from the .proto files under proto/ in place of a list: it
# renders the envoy.yaml and rpc-table.json that gateway.conf and gateway.yaml render.
listen = 8000
timeouts { request = 30s }
services {
  web { http = 3000, address = "10.0.0.5" }
  identity { http = 4000, address = "::1" }
  backend { grpc = 5000 }
}
auth {
  ask = "identity /check"
  timeout = 250ms
  enabled = false
  when_unavailable = deny
  send = [authorization]
  accept = [x-identity]
}
origins {
  only { hosts = [gateway.example.net], origins = ["https://app.example.net"] }
}
routes = [
  { rpc { to { "*" = backend } } }
  { name = login, path = /login, method = POST, to = identity, rewrite = /session, auth = off }
  { name = web, prefix = /, to = web }
]
log { status_from = 500, sample = 0% }
rpc {
  proto {
    roots = [proto]
    option = example.gateway.v1.route
  }
}
envoy { heap = 64MiB }
