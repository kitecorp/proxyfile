# The jwt example in HOCON. It gives the same envoy.yaml as ../yaml/proxyfile.yaml.
listen = 8000
services {
  app { http = 3000 }
  identity { http = 4000 }
}
auth {
  jwt {
    issuer = "https://login.example.com"
    audiences = [api.example.com]
    keys = /etc/gateway/jwt/jwks.json
    claims {
      x-user-id = sub
      x-user-roles = realm.roles
    }
  }
}
origins {
  all { hosts = [localhost], origins = ["http://localhost:3000"] }
}
routes = [
  { name = sign-in, prefix = /login/, to = identity, auth = off }
  { name = app, prefix = /, to = app }
]
